<idea-plugin>
    <id>dev.michaelomichael.methodnumbers</id>
    <name>Method Number Hints</name>
    <vendor>Michaelomichael</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>
    
    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="dev.michaelomichael.intellij.plugins.methodnumbers.services.MethodCountingService" id="MethodCountingService"/>
        <codeInsight.declarativeInlayProviderFactory implementation="dev.michaelomichael.intellij.plugins.methodnumbers.hints.MethodNumbersInlayHintsFactory"/>
        <applicationService serviceImplementation="dev.michaelomichael.intellij.plugins.methodnumbers.settings.AppSettings"/>
        <applicationConfigurable
            parentId="tools"
            instance="dev.michaelomichael.intellij.plugins.methodnumbers.settings.AppSettingsConfigurable"
            id="dev.michaelomichael.intellij.plugins.methodnumbers.settings.AppSettingsConfigurable"
            key="settings.title"
            bundle="messages.MyBundle"
            />
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" />
    </extensions>
</idea-plugin>
